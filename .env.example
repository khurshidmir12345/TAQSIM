APP_NAME=Nonvoyxona
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8086

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nonvoyxona
DB_USERNAME=nonvoyxona
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@nonvoyxona.uz"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# DevSMS (devsms.uz)
DEVSMS_TOKEN=
DEVSMS_FROM=4546

# Sign in with Apple — iOS bundle ID(lar), vergul bilan ajratish mumkin
APPLE_CLIENT_IDS=uz.taqseem.app

# Google Sign-In — ruxsat etilgan OAuth client ID(lar), vergul bilan ajratiladi
# (Web/server + iOS + Android client ID).
GOOGLE_CLIENT_IDS=

# Filament admin panel (AdminUserSeeder)
FILAMENT_ADMIN_EMAIL=
FILAMENT_ADMIN_PASSWORD=
FILAMENT_ADMIN_NAME=

# Telegram register bot (SystemBotSeeder)
TELEGRAM_REGISTER_BOT_TOKEN=
TELEGRAM_REGISTER_BOT_NAME=
TELEGRAM_REGISTER_BOT_USERNAME=

# Web ilova manzili — Telegram orqali web'dan kirilganda muvaffaqiyatli
# tugagach foydalanuvchi shu manzil + /telegram'ga yo'naltiriladi.
WEB_APP_URL=https://web.taqseem.uz

# ── Ilova yangilanishi ─────────────────────────────────────────────
# APP_UPDATE_ENABLED=false bo'lsa ilova modalka umuman ko'rsatmaydi.
# Versiya do'kondagi eng so'nggi versiya: `1.2.8` yoki `1.2.8+40`.
# Ilovaning o'z versiyasi shundan kichik bo'lsa "yangilanish bor" deyiladi.
# Versiya bo'sh qoldirilsa o'sha platforma uchun tekshiruv o'chadi.
APP_UPDATE_ENABLED=false
APP_UPDATE_ANDROID_VERSION=
APP_UPDATE_ANDROID_URL=https://play.google.com/store/apps/details?id=uz.taqseem.mobile
APP_UPDATE_IOS_VERSION=
APP_UPDATE_IOS_URL=

# ── Kirish muddati (freemium) ──────────────────────────────────────
# ACCESS_ENABLED=false bo'lsa hech kimga hech qanday cheklov qo'llanmaydi —
# muddati tugaganlarga ham barcha bo'limlar ochiq qoladi (deploysiz
# to'xtatish tugmasi).
# ACCESS_CONTACT faqat Telegram xabarida ko'rsatiladi, ilovaga uzatilmaydi.
ACCESS_ENABLED=false
ACCESS_TRIAL_DAYS=30
ACCESS_CONTACT=@taqseem_uz
